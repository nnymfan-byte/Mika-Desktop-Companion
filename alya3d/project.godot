[application]
config/name="Alya 3D Desktop Companion"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=360
window/size/viewport_height=520
window/size/window_width_override=360
window/size/window_height_override=520
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.03,0.04,0.07,1)

[gui]
theme/default_font_multichannel_signed_distance_field=true

[export]

[preset.0]
name="Windows Desktop"
platform="Windows Desktop"
runnable=true
dedicated_server=false
custom_features=""
binary_format/architecture="x86_64"
binary_format/embed_pck=true
texture_format/bptc=true
texture_format/s3tc=true
texture_format/etc2=true
texture_format/no_bptc=false
texture_format/no_s3tc=false
texture_format/no_etc2=false
application/icon=""
application/console_wrapper_icon=""
application/file_version=""
application/product_version=""
application/company_name=""
application/product_name="Alya 3D Desktop Companion"
application/file_description="Alya 3D desktop companion"
application/copyright=""
application/trademarks=""
export_filter="all_resources"
include_filter=""
exclude_filter=""
export_path="build/Alya3D.exe"
